    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:allowBackup="false" android:label="GSA FieldForce" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/ic_fieldforce">
